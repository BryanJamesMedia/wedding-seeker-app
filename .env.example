# Required
DATABASE_URL=                 # Neon pooled connection string
BETTER_AUTH_SECRET=           # 32+ random characters
BETTER_AUTH_URL=              # e.g. https://app.weddingseeker.com
NEXT_PUBLIC_APP_URL=          # same as above
SIGNING_SECRET=               # 32+ random characters (vendor response links)
CRON_SECRET=                  # Vercel sets this for cron calls

# Embeddings (must match the model that produced the existing vectors)
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# Email (Resend)
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
EMAIL_FROM=Wedding Seeker <hello@weddingseeker.com>
CONNECT_EMAIL_FROM=Wedding Seeker <connect@weddingseeker.com>
EMAIL_MODE=                   # "production" only on the live site; otherwise vendor email goes to VENDOR_TEST_INBOX
VENDOR_TEST_INBOX=
ADMIN_EMAILS=b@lekmedia.com
INBOUND_REPLY_DOMAIN=
INBOUND_SECRET=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
STRIPE_BILLING_MODE=payment   # "payment" (one-time) or "subscription"
ONE_TIME_ACCESS_DAYS=
NEXT_PUBLIC_PLAN_PRICE_LABEL=

# Google sign-in (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_SUPPORT_EMAIL=support@weddingseeker.com
